# Copy to .env.local for development, or .env on the server.
#
# Keys marked [site-config] can also be stored as rows in the `site_configs`
# table, and the database value WINS over the value here. Change one in the
# wrong place and nothing happens — check the table first:
#   SELECT `key` FROM site_configs;
#
# Values below are placeholders. Never commit a filled-in file.

# ── Required: the server refuses to start without these ──────────────────────

DATABASE_URL="mysql://user:password@127.0.0.1:3306/transaksikilat"
# At least 32 characters — iron-session will not seal a cookie with less.
SESSION_SECRET="change-me-to-a-random-string-of-32-chars-or-more"

# ── App identity and URLs ────────────────────────────────────────────────────

APP_NAME="Transaksi Kilat"
APP_URL="https://example.com"
# Must start with https:// in production, or the session cookie loses its
# Secure attribute.
NEXT_PUBLIC_APP_NAME="Transaksi Kilat"
NEXT_PUBLIC_APP_URL="https://example.com"
NEXT_PUBLIC_BASE_URL="https://example.com"
# "production" disables the dev-only payment simulation endpoints.
APP_ENV="production"
HEADER_COLOR="#003D99"                      # [site-config] #RRGGBB

# ── Provider: Digiflazz ──────────────────────────────────────────────────────

PROVIDER_DIGIFLAZZ_MODE="mock"              # [site-config] mock | real
DIGIFLAZZ_USERNAME=""                       # [site-config]
DIGIFLAZZ_API_KEY=""                        # [site-config]
DIGIFLAZZ_BASE_URL="https://api.digiflazz.com/v1"   # [site-config]

# ── Provider: VIP Reseller ───────────────────────────────────────────────────

PROVIDER_VIP_MODE="mock"                    # [site-config] mock | real
VIP_API_ID=""                               # [site-config]
VIP_API_KEY=""                              # [site-config]
VIP_SIGN=""                                 # [site-config] md5(VIP_API_ID + VIP_API_KEY)
VIP_BASE_URL="https://vip-reseller.co.id/api"       # [site-config]
# [site-config] Set to 1 only once production logs show genuine callbacks
# reporting "Signature verified". Refuses unsigned callbacks when on.
VIP_WEBHOOK_SIGNATURE_REQUIRED=""

# ── Payment gateway: Poppay (satu-satunya gateway yang dipakai) ──────────────────────────────────────────────────

POPPAY_API_BASE_URL=""
POPPAY_URL=""
POPPAY_PORT=""
POPPAY_VERSION=""
POPPAY_INTEGRATOR_TOKEN=""
POPPAY_AGGREGATOR_CODE=""
POPPAY_MERCHANT_ACCOUNT_NUMBER=""
POPPAY_EMAIL=""
POPPAY_PASSWORD=""
POPPAY_SECRET_KEY=""                        # [site-config] signs incoming callbacks
# [site-config] Set to 1 only once production logs show genuine callbacks
# reporting "Signature verified". Refuses invalid signatures when on.
POPPAY_WEBHOOK_SIGNATURE_REQUIRED=""

# ── Fees ─────────────────────────────────────────────────────────────────────

PAYMENT_GATEWAY_QRIS_FEE_TYPE="FIXED"       # FIXED | PERCENT
PAYMENT_GATEWAY_QRIS_FEE_VALUE="0"
MERCHANT_PLATFORM_FEE_TYPE="FIXED"          # [site-config] FIXED | PERCENT
MERCHANT_PLATFORM_FEE_VALUE="0"             # [site-config]

# ── Email (OTP, notifications) ───────────────────────────────────────────────

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ── WhatsApp (Fonnte) ────────────────────────────────────────────────────────

FONNTE_TOKEN=""

# ── Feature flags ────────────────────────────────────────────────────────────

REGISTER_OTP_REQUIRED=""                    # [site-config] 1 to require OTP on register
REQUIRE_LOGIN_TO_PURCHASE=""                # [site-config] 1 to block guest checkout

# ── Scheduled jobs ───────────────────────────────────────────────────────────

# Shared secret for /api/cron/* endpoints. Without it those endpoints refuse
# every request. Generate a long random string.
CRON_SECRET=""

# ── Development only ─────────────────────────────────────────────────────────

MOCK_PROVIDER_SCENARIO=""                   # forces a mock provider outcome
MOCK_PROVIDER_DELAY_MS=""
